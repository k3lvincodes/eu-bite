{
  "name": "eu-bite-bot",
  "version": "1.0.0",
  "private": true,
  "description": "EU Bite WhatsApp Cloud API Webhook Integration and Conversational Ordering Experience",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
